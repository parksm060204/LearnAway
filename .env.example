# ==========================================
# Learn my way Academic AI Service Configuration
# ==========================================

# ------------------------------------------
# Supabase Authentication (Google login)
# ------------------------------------------
# These two values are required for login. They are public (browser-safe) and
# are read through literal NEXT_PUBLIC_* variables so Next.js can inline them.
# Where to find them: Supabase Dashboard > Project Settings > API (Project URL
# and Publishable key). NEVER put the service_role/secret key here.
# See docs/auth-setup.md for the full external setup steps.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional: overrides the absolute URL used by the OAuth redirect when running
# behind a proxy/tunnel. Usually not needed; the app derives it from request
# headers or window.location.origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------
# Provider selection
# ------------------------------------------
# When set, AI_PROVIDER explicitly selects ONE provider and its key/base/model
# are used together. Allowed: gemini | openai | deepseek | school_gateway.
# When unset, the app keeps the legacy behaviour of inferring the provider from
# whichever key is present (Gemini > OpenAI > DeepSeek). A selected provider with
# a missing key is left unconfigured; it never falls back to another paid model.
# AI_PROVIDER=school_gateway

# Primary AI API Key (Universal) — only used by the legacy Gemini fallback.
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-3.5-flash
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# Gemini Configuration (제미나이 3.5 프리뷰 / Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek Configuration (Alternative)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com

# ------------------------------------------
# Incheon National University AI:NU BAZE API Gateway
# ------------------------------------------
# Set AI_PROVIDER=school_gateway (above) to use these values. The BAZE key is a
# SERVER-ONLY secret: never expose it through a NEXT_PUBLIC_* variable.
# Allowed only in server environment variables (.env.local / deployment secrets).
# Keys are issued in BAZE under "API Gateway".
AI_PROVIDER=school_gateway
BAZE_API_KEY=your_baze_api_key_here
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
BAZE_MODEL=deepseek-v4.1-flash
# Reasoning model output floor (tokens). deepseek-v4.1-flash needs a large budget
# or it can return an empty/truncated answer. Defaults to 16000.
# BAZE_MIN_OUTPUT_TOKENS=16000
# Optional: opt in to JSON mode only if the model is verified to support it.
# BAZE_JSON_MODE=json_object
#
# Optional: leave BAZE_API_KEY empty to require each user to register their own
# key under Settings > 내 AI API 연결. If BAZE_API_KEY is set it is used only for
# users who have not registered a key; a failing user key never falls back to it.

# ------------------------------------------
# Per-user credential encryption (server-only)
# ------------------------------------------
# 32-byte key (base64, 64-char hex, or 32 raw chars) used to encrypt each user's
# API key before storing it. NEVER expose this through NEXT_PUBLIC_* or client
# code. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_CREDENTIAL_ENCRYPTION_KEY=your_32_byte_base64_key
