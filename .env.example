# ==========================================
# Learn my way Academic AI Service Configuration
# ==========================================

# ------------------------------------------
# Supabase Authentication (Google login)
# ------------------------------------------
# These two values are required for login. They are public (browser-safe) and
# are read through literal NEXT_PUBLIC_* variables so Next.js can inline them.
# Where to find them: Supabase Dashboard > Project Settings > API (Project URL
# and Publishable key). NEVER put the service_role/secret key here.
# See docs/auth-setup.md for the full external setup steps.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional: overrides the absolute URL used by the OAuth redirect when running
# behind a proxy/tunnel. Usually not needed; the app derives it from request
# headers or window.location.origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Primary AI API Key (Universal)
AI_API_KEY=your_api_key_here
AI_MODEL=gemini-3.5-flash
AI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# Gemini Configuration (제미나이 3.5 프리뷰 / Flash)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek Configuration (Alternative)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
